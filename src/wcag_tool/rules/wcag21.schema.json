{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/adamwpryor/wcag-tool/rules/wcag21.schema.json",
  "title": "WCAG 2.1 Level A and AA success criteria, quoted from W3C",
  "type": "object",
  "required": ["source", "source_date", "copyright", "license", "criteria"],
  "additionalProperties": false,
  "properties": {
    "source": { "const": "https://www.w3.org/TR/WCAG21/" },
    "source_date": { "type": "string", "minLength": 1 },
    "copyright": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "format": "uri" },
    "criteria": {
      "type": "array",
      "minItems": 50,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "level", "text", "understanding"],
        "properties": {
          "id": { "type": "string", "pattern": "^[1-4]\\.[0-9]+\\.[0-9]+$" },
          "name": { "type": "string", "minLength": 1 },
          "level": { "enum": ["A", "AA"] },
          "text": { "type": "string", "minLength": 1 },
          "understanding": {
            "type": "string",
            "pattern": "^https://www\\.w3\\.org/WAI/WCAG21/Understanding/[a-z0-9-]+\\.html$"
          }
        }
      }
    }
  }
}
